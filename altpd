          { q: "Bán kính của đường tròn là:", a: ["Độ dài từ tâm đến mép đường tròn", "Độ dài đường kính", "Bán kính là chu vi", "Mỗi cạnh hình vuông"], c: 0 },
          { q: "Đâu là thành phố lớn nhất Việt Nam?", a: ["Hà Nội", "Đà Nẵng", "TP.HCM", "Cần Thơ"], c: 2 }
