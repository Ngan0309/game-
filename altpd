      },
      "khó": {
        rounds: 8,
        prizeBase: 3000000,
        questions: [
          { q: "Phân tích x² - 9 thành nhân tử:", a: ["(x-3)(x+3)", "(x-9)(x+1)", "(x-1)(x+9)", "(x-3)²"], c: 0 },
