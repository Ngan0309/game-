          { q: "Trong câu văn, từ nào là danh từ?", a: ["Xanh", "Mẹ", "Đi", "Rất"], c: 1 }
        ]
      },
      "dễ": {
        rounds: 8,
        prizeBase: 500000,
        questions: [
          { q: "Trong văn học, từ nào là từ láy?", a: ["Mẹ", "Lấp lánh", "Trẻ", "Học"], c: 1 },
          { q: "Số 9 là số nguyên tố hay hợp số?", a: ["Nguyên tố", "Hợp số", "Không phải cả hai", "Chỉ là số chẵn"], c: 1 },
          { q: "Thủ đô của Việt Nam là?", a: ["Đà Nẵng", "Hà Nội", "Huế", "TP.HCM"], c: 1 },
          { q: "Quả nào có hạt trong?", a: ["Táo", "Chuối", "Dưa hấu", "Cà chua"], c: 0 },
          { q: "Hòa âm trong âm nhạc là gì?", a: ["Âm thanh đơn", "Sự kết hợp âm thanh", "Lời bài hát", "Nhịp điệu"], c: 1 },
          { q: "Nước nào có hình chữ thập ở quốc kỳ?", a: ["Thụy Sĩ", "Na Uy", "Thái Lan", "Nhật Bản"], c: 2 },
          { q: "Phép tính 15 ÷ 3 = ?", a: ["4", "5", "6", "7"], c: 1 },
          { q: "Từ nào là từ trái nghĩa với 'đẹp'?", a: ["Xấu", "Vui", "Máu", "Trẻ"], c: 0 }
        ]
      },
      "trung bình": {
        rounds: 8,
        prizeBase: 1000000,
        questions: [
          { q: "Tác phẩm 'Truyện Kiều' của Nguyễn Du thuộc thể loại nào?", a: ["Thơ lục bát", "Truyện thơ", "Thơ tự do", "Bài ca"], c: 1 },
          { q: "Biểu thức nào là đơn thức?", a: ["x + 2", "3x", "x - y", "a + b"], c: 1 },
          { q: "Phương trình x + 5 = 9 có x bằng:", a: ["3", "4", "5", "6"], c: 1 },
          { q: "Đại dương lớn nhất thế giới là?", a: ["Đại Tây Dương", "Thái Bình Dương", "Ấn Độ Dương", "Bắc Băng Dương"], c: 1 },
