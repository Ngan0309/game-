<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI LÀ TRIỆU PHÚ - V14</title>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #071a3d, #0b2d62, #1c5abf);
      color: white;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .app {
      width: min(1000px, 95vw);
      min-height: 700px;
      background: rgba(5, 13, 35, 0.85);
      border: 2px solid rgba(255,255,255,0.12);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 0 35px rgba(0,0,0,0.45);
      position: relative;
      overflow: hidden;
    }

    .screen { display: none; position: relative; z-index: 2; }
    .screen.active { display: block; animation: fadeIn 0.25s ease; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .title {
      text-align: center;
      font-size: clamp(2.5rem, 5vw, 4.8rem);
      font-weight: 900;
      color: #ffd54a;
      letter-spacing: 2px;
      text-shadow: 0 0 18px rgba(255,213,74,0.6);
      margin-bottom: 18px;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .subtitle {
      text-align: center;
      color: #dfe8ff;
      font-size: 1.15rem;
      line-height: 1.5;
      margin-bottom: 30px;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .main-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 16px 24px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    button:hover { transform: translateY(-2px); }
    button:active { transform: translateY(0); }

    .primary {
      background: linear-gradient(135deg, #ffb300, #ff8f00);
      color: #111;
      min-width: 180px;
    }

    .secondary {
      background: #dfe8ff;
      color: #14315f;
      min-width: 160px;
    }

    .ghost {
      background: rgba(255,255,255,0.08);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.12);
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(180px, 1fr));
      gap: 16px;
      max-width: 620px;
      margin: 0 auto;
    }

    .difficulty-btn {
      background: linear-gradient(180deg, #214c94, #183b75);
      color: white;
      border: 1px solid rgba(255,255,255,0.15);
      min-height: 80px;
      font-size: 1.05rem;
    }

    .instruction-box {
      max-width: 700px;
      margin: 0 auto;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 20px 22px;
      line-height: 1.8;
      color: #eef4ff;
    }

    .instruction-box ul {
      margin: 0;
      padding-left: 18px;
    }

    .game-layout {
      display: grid;
      grid-template-columns: 1.7fr 0.8fr;
      gap: 22px;
      min-height: 640px;
    }

    .board {
      background: rgba(8, 18, 40, 0.8);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .question-box {
      background: linear-gradient(180deg, #0a1f46, #103769);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 14px;
      padding: 28px 20px;
      min-height: 170px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: clamp(1.2rem, 2vw, 1.8rem);
      line-height: 1.5;
      margin-bottom: 16px;
      color: white;
      animation: questionIn 0.35s ease;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    @keyframes questionIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .answers {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .answer {
      background: linear-gradient(180deg, #1d3f82, #143669);
      color: white;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      padding: 18px 14px;
      text-align: left;
      display: flex;
      align-items: center;
      min-height: 90px;
      font-size: 1.05rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      animation: answerIn 0.3s ease;
      cursor: pointer;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    @keyframes answerIn {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .answer:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.18);
    }

    .answer .label {
      width: 34px;
      height: 34px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      background: rgba(255,255,255,0.11);
      border-radius: 50%;
      margin-right: 12px;
      font-weight: bold;
      color: #ffd54a;
      flex-shrink: 0;
    }

    .answer.correct {
      background: linear-gradient(180deg, #19a85d, #116f43);
      border-color: rgba(255,255,255,0.4);
    }

    .answer.wrong {
      background: linear-gradient(180deg, #d73a3a, #8b1d1d);
      border-color: rgba(255,255,255,0.4);
    }

    .answer.selected {
      outline: 3px solid #ffc857;
      box-shadow: 0 0 0 3px rgba(255,200,87,0.25);
    }

    .side-panel {
      background: rgba(8, 18, 40, 0.8);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      padding: 16px;
    }

    .money-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .money-list li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid transparent;
    }

    .money-list li.active {
      background: rgba(255,213,74,0.12);
      border-color: rgba(255,213,74,0.6);
      color: #ffe48d;
      font-weight: bold;
    }

    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      color: #dfe8ff;
      font-size: 0.95rem;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      gap: 10px;
      flex-wrap: wrap;
    }

    .controls {
      display: flex;
      justify-content: flex-end;
      margin-top: 18px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .small-btn {
      min-width: 160px;
    }

    .next-panel {
      display: none;
      margin-top: 18px;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .next-panel.visible {
      display: flex;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.62);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 50;
    }

    .modal.active { display: flex; }

    .modal-card {
      width: min(480px, 92vw);
      background: linear-gradient(180deg, #152d5e, #0e2144);
      border-radius: 18px;
      padding: 28px 22px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.15);
      box-shadow: 0 18px 40px rgba(0,0,0,0.35);
    }

    .modal-card h2 {
      margin-top: 0;
      margin-bottom: 12px;
      font-size: clamp(1.7rem, 3vw, 2.5rem);
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .modal-card p {
      color: #dfe8ff;
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 22px;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .timer {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 6px 10px;
      border-radius: 999px;
      font-weight: bold;
      color: #ffd54a;
      min-width: 90px;
      text-align: center;
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 31;
    }

    .timer.warning { color: #ffb36b; border-color: rgba(255,179,107,0.6); }
    .timer.danger  { color: #ff7a7a; border-color: rgba(255,122,122,0.6); }

    @media (max-width: 780px) {
      .game-layout { grid-template-columns: 1fr; }
      .answers { grid-template-columns: 1fr; }
      .menu-grid { grid-template-columns: 1fr; }
      .timer {
        position: static;
        display: inline-block;
        margin: 0 auto 18px;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <div id="timer" class="timer">30s</div>

    <section id="homeScreen" class="screen active">
      <div class="title">AI LÀ TRIỆU PHÚ</div>
      <div class="subtitle">Cùng thử thách trí nhớ và kiến thức của bạn!</div>

      <div class="main-buttons">
        <button id="playBtn" class="primary">Chơi ngay</button>
        <button id="guideBtn" class="secondary">Hướng dẫn chơi</button>
        <button id="menuBtn" class="ghost">Menu</button>
      </div>
    </section>

    <section id="menuScreen" class="screen">
      <div class="title">MENU</div>
      <div class="subtitle">Chọn mức độ bạn muốn thử thách</div>

      <div class="menu-grid">
        <button class="difficulty-btn" data-level="siêu dễ">Siêu dễ</button>
        <button class="difficulty-btn" data-level="dễ">Dễ</button>
        <button class="difficulty-btn" data-level="trung bình">Trung bình</button>
        <button class="difficulty-btn" data-level="khó">Khó</button>
        <button class="difficulty-btn" data-level="nâng cao">Nâng cao</button>
        <button class="difficulty-btn" data-level="custom" style="grid-column: span 2;">Chơi nhanh</button>
      </div>

      <div class="main-buttons" style="margin-top: 24px;">
        <button id="backFromMenu" class="secondary">Quay lại</button>
      </div>
    </section>

    <section id="guideScreen" class="screen">
      <div class="title">HƯỚNG DẪN CHƠI</div>
      <div class="instruction-box">
        <ul>
          <li>Mỗi câu hỏi có 30 giây để trả lời.</li>
          <li>Chọn mức độ phù hợp với khả năng của bạn.</li>
          <li>Mỗi màn có 1 câu hỏi mới.</li>
          <li>Chọn đáp án đúng để tiếp tục sang màn tiếp theo.</li>
          <li>Nếu trả lời sai hoặc hết giờ, trò chơi kết thúc.</li>
          <li>Để thắng, bạn cần trả lời đúng càng nhiều câu càng tốt.</li>
        </ul>
      </div>

      <div class="main-buttons" style="margin-top: 24px;">
        <button id="backFromGuide" class="secondary">Quay lại</button>
      </div>
    </section>

    <section id="gameScreen" class="screen">
      <div class="status-bar">
        <div id="levelInfo">Màn 1</div>
        <div id="moneyInfo">0đ</div>
      </div>

      <div class="game-layout">
        <div class="board">
          <div id="questionBox" class="question-box">Câu hỏi sẽ hiển thị ở đây</div>

          <div id="answers" class="answers"></div>

          <div class="controls">
            <button id="quitBtn" class="secondary small-btn">Bỏ cuộc</button>
            <button id="homeBtnGame" class="ghost small-btn">Về trang chủ</button>
          </div>

          <div id="nextPanel" class="next-panel">
            <button id="nextBtn" class="primary">Sang màn tiếp theo</button>
            <button id="homeBtnCenter" class="secondary">Về lại trung tâm</button>
          </div>
        </div>

        <aside class="side-panel">
          <h3 style="margin:0; color:#ffd54a;">Mức thưởng</h3>
          <ul id="moneyList" class="money-list"></ul>
        </aside>
      </div>
    </section>
  </div>

  <div id="resultModal" class="modal">
    <div class="modal-card">
      <h2 id="resultTitle">Kết quả</h2>
      <p id="resultText"></p>

      <div class="main-buttons" style="margin-top:10px;">
        <button id="restartBtn" class="primary">Chơi lại</button>
        <button id="homeBtnModal" class="secondary">Về trang chủ</button>
      </div>
    </div>
  </div>

  <script>
    const levelOrder = ["siêu dễ", "dễ", "trung bình", "khó", "nâng cao", "custom"];

    const levels = {
      "siêu dễ": {
        rounds: 8,
        prizeBase: 200000,
        questions: [
          { q: "Trong tiếng Việt, từ nào là từ đồng nghĩa với 'trẻ trung'?", a: ["Già nua", "Măng mọc", "Tuổi trẻ", "Mềm mại"], c: 2 },
          { q: "Tổng của 12 + 8 là?", a: ["18", "20", "22", "24"], c: 1 },
          { q: "Nhà văn nào viết truyện ngắn 'Lặng lẽ Sa Pa'?", a: ["Nam Cao", "Tô Hoài", "Nguyễn Nhật Ánh", "Nguyễn Du"], c: 2 },
          { q: "Một năm có bao nhiêu tháng?", a: ["10", "11", "12", "13"], c: 2 },
          { q: "Hành tinh nào gần Mặt Trời nhất?", a: ["Trái Đất", "Sao Thủy", "Sao Hỏa", "Sao Mộc"], c: 1 },
          { q: "Đâu là một con vật sống dưới nước?", a: ["Cá", "Bò", "Mèo", "Chim"], c: 0 },
